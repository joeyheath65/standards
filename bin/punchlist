#!/usr/bin/env python3
"""Add, close and hand off punchlist items.

Exists because three things kept going wrong by hand:

  1. IDs were hand-allocated, so they collided and drifted. gcp-autobot ran
     P1 P2 P3 P4 P6 with P5 in another section entirely.
  2. "Prune on the next pass" never came. slotd-web accumulated 56 closed
     items in a 1337-line file. A punchlist nobody can read is a punchlist
     nobody trusts.
  3. Cross-repo handoffs were filed by hand with inconsistent wording, so
     nothing could find them mechanically.

`close` moves the item into BUILD_PLAN.md's shipped history in one step, so
closing and pruning are the same action and cannot drift apart.

    punchlist add   <repo> --type CODE --text "..."
    punchlist close <repo> P12 [--note "what actually shipped"]
    punchlist file  <repo> --to <other-repo> --type CODE --text "..." [--blocks P7]
    punchlist ls    <repo> [--type OWNER]

Defaults to a dry run everywhere. Pass --apply to write.
"""
from __future__ import annotations

import argparse
import datetime as dt
import re
import sys
from pathlib import Path

TYPES = ("CODE", "OWNER", "DOCS", "GROWTH")
ITEM = re.compile(r"^(?P<indent>\s*)- P(?P<num>\d+)\.\s+`\[(?P<state>[ ~x])\]`(?P<rest>.*)$")


def repo_path(raw: str) -> Path:
    p = Path(raw).expanduser()
    if not p.exists():
        p = Path.home() / "dev/work/lawndart" / raw
    if not (p / "PUNCHLIST.md").is_file():
        sys.exit(f"punchlist: no PUNCHLIST.md in {p}")
    return p.resolve()


def parse(text: str) -> list[dict]:
    out = []
    for i, line in enumerate(text.splitlines()):
        m = ITEM.match(line)
        if m:
            out.append({"line": i, "num": int(m.group("num")),
                        "state": m.group("state"), "rest": m.group("rest").strip(),
                        "raw": line})
    return out


def body_of(lines: list[str], start: int) -> tuple[int, list[str]]:
    """An item owns its continuation lines - everything until the next item or
    heading. Closing must take the whole block, not just the first line."""
    end = start + 1
    while end < len(lines):
        nxt = lines[end]
        if ITEM.match(nxt) or nxt.startswith("#") or nxt.startswith("---"):
            break
        end += 1
    return end, lines[start:end]


def next_id(items: list[dict]) -> int:
    return max((i["num"] for i in items), default=0) + 1


def cmd_ls(repo: Path, args) -> int:
    items = parse((repo / "PUNCHLIST.md").read_text())
    shown = 0
    for it in items:
        if args.type and f"**{args.type}" not in it["rest"]:
            continue
        if it["state"] == "x":
            continue
        kind = next((t for t in TYPES if f"**{t}" in it["rest"]), "?")
        summary = re.sub(r"[*`_]", "", it["rest"])[:88]
        print(f"  P{it['num']:<4} [{it['state']}] {kind:<7} {summary}")
        shown += 1
    print(f"\n{repo.name}: {shown} open item(s)")
    return 0


def cmd_add(repo: Path, args) -> int:
    path = repo / "PUNCHLIST.md"
    text = path.read_text()
    lines = text.splitlines()
    items = parse(text)
    nid = next_id(items)

    entry = f"- P{nid}. `[ ]` **{args.type}**"
    if args.blocks:
        entry += f" · blocks: {args.blocks}"
    entry += f" — {args.text}"
    if args.filed_by:
        entry += (f"\n  *(Filed from a `{args.filed_by}` session {args.today} as a cross-repo "
                  f"handoff — `ld-2026-07-31-cross-repo-handoff-via-punchlist`.)*")

    # Insert after the last existing item so ids stay monotonic in the file.
    if items:
        anchor, _ = body_of(lines, items[-1]["line"])
    else:
        anchor = next((i for i, l in enumerate(lines) if l.startswith("## ")), len(lines)) + 1
    lines[anchor:anchor] = entry.splitlines()

    print(f"  {repo.name}: + P{nid} ({args.type})")
    for l in entry.splitlines():
        print(f"    {l}")
    if not args.apply:
        print("\ndry run. re-run with --apply to write")
        return 0
    path.write_text("\n".join(lines) + "\n")
    return 0


def cmd_close(repo: Path, args) -> int:
    pl, bp = repo / "PUNCHLIST.md", repo / "BUILD_PLAN.md"
    text = pl.read_text()
    lines = text.splitlines()
    items = parse(text)
    num = int(args.id.lstrip("Pp"))
    match = next((i for i in items if i["num"] == num), None)
    if not match:
        sys.exit(f"punchlist: {repo.name} has no P{num}")

    end, block = body_of(lines, match["line"])
    del lines[match["line"]:end]

    summary = re.sub(r"^\s*- P\d+\.\s+`\[[ ~x]\]`\s*", "", block[0]).strip()
    shipped = f"- **P{num}** ({args.today}) — {summary}"
    if args.note:
        shipped += f"\n  _{args.note}_"

    print(f"  {repo.name}: closing P{num}")
    print(f"    - removed {len(block)} line(s) from PUNCHLIST.md")
    if bp.is_file():
        btext = bp.read_text()
        header = "\n## Shipped\n"
        if "## Shipped" not in btext:
            btext = btext.rstrip() + "\n" + header + "\n" + shipped + "\n"
        else:
            idx = btext.index("## Shipped") + len("## Shipped")
            btext = btext[:idx] + "\n\n" + shipped + btext[idx:]
        print(f"    + appended to BUILD_PLAN.md ## Shipped")
    else:
        print("    ! no BUILD_PLAN.md — the item would be lost, refusing")
        return 1

    if not args.apply:
        print("\ndry run. re-run with --apply to write")
        return 0
    pl.write_text("\n".join(lines) + "\n")
    bp.write_text(btext)
    return 0


def cmd_file(repo: Path, args) -> int:
    target = repo_path(args.to)
    args.filed_by = repo.name
    print(f"  filing from {repo.name} -> {target.name}")
    rc = cmd_add(target, args)
    if args.blocks:
        print(f"  note: marked as blocking {args.blocks} in {repo.name}")
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("command", choices=("add", "close", "file", "ls"))
    ap.add_argument("repo")
    ap.add_argument("id", nargs="?", help="item id for `close`, e.g. P12")
    ap.add_argument("--type", choices=TYPES, default=None,
                    help="filter for `ls`; the item type for `add`/`file` (default CODE)")
    ap.add_argument("--text", default="")
    ap.add_argument("--to", help="target repo for `file`")
    ap.add_argument("--blocks", help="item id in the filing repo this gates")
    ap.add_argument("--note", help="what actually shipped, for `close`")
    ap.add_argument("--today", default=dt.date.today().isoformat())
    ap.add_argument("--apply", action="store_true")
    args = ap.parse_args()
    args.filed_by = None
    # `ls` treats --type as an optional filter; add/file need a concrete type.
    if args.command in ("add", "file") and args.type is None:
        args.type = "CODE"

    repo = repo_path(args.repo)
    if args.command in ("add", "file") and not args.text:
        sys.exit("punchlist: --text is required")
    if args.command == "close" and not args.id:
        sys.exit("punchlist: close needs an id, e.g. P12")
    if args.command == "file" and not args.to:
        sys.exit("punchlist: file needs --to")

    return {"ls": cmd_ls, "add": cmd_add, "close": cmd_close, "file": cmd_file}[args.command](repo, args)


if __name__ == "__main__":
    sys.exit(main())
